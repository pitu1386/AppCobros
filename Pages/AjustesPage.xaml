<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCobros.PageModels"
             x:Class="AppCobros.Pages.AjustesPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F4F3FB, Dark=#141221}">

    <ScrollView Padding="14">
        <VerticalStackLayout Spacing="12">

            <!-- Apariencia -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="APARIENCIA" Style="{StaticResource SectionTitle}" />
                    <Label Text="Tema de la aplicación" Style="{StaticResource FieldLabel}" />
                    <Picker SelectedIndex="{Binding TemaSeleccionado}">
                        <Picker.Items>
                            <x:String>Sistema (automático)</x:String>
                            <x:String>Claro</x:String>
                            <x:String>Oscuro</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Grupos y Cuotas -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="GRUPOS Y CUOTAS" Style="{StaticResource SectionTitle}" />

                    <StackLayout BindableLayout.ItemsSource="{Binding Grupos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                                    <Entry Grid.Column="0" Text="{Binding Nombre}" Placeholder="Nombre" />
                                    <Entry Grid.Column="1" Text="{Binding Cuota}" Placeholder="Cuota" Keyboard="Numeric" />
                                    <Button Grid.Column="2" Text="🕒" Style="{StaticResource BtnGhost}" CornerRadius="8" WidthRequest="38" HeightRequest="38" Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AjustesViewModel}}, Path=VerHistorialCuotaCommand}" CommandParameter="{Binding .}" />
                                    <Button Grid.Column="3" Text="🗑" Style="{StaticResource BtnDanger}" CornerRadius="8" WidthRequest="38" HeightRequest="38"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AjustesViewModel}}, Path=EliminarGrupoCommand}" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>

                    <Button Text="＋ Agregar grupo" Style="{StaticResource BtnGhost}" Command="{Binding AgregarGrupoCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Anexos -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ANEXOS" Style="{StaticResource SectionTitle}" />
                    <Label Text="Precio por anexo (mensual)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Config.Anexo}" Keyboard="Numeric" />
                    <Label Text="Se suma a la cuota del grupo por cada anexo que tenga el cliente." Style="{StaticResource Hint}" />
                </VerticalStackLayout>
            </Border>

            <!-- Cotización Euro -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="COTIZACIÓN DEL EURO" Style="{StaticResource SectionTitle}" />
                    <Label Text="Pesos por 1 €" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Config.CotizacionEuro}" Keyboard="Numeric" Placeholder="Ej: 1650" />
                    <Label Text="Se usa en el Dashboard para mostrar lo recaudado del mes en euros. Cada pago guarda la cotización vigente al registrarlo. Dejá 0 para ocultar la card." Style="{StaticResource Hint}" />
                </VerticalStackLayout>
            </Border>

            <!-- Plantilla Cobro -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="MENSAJE AL REGISTRAR COBRO" Style="{StaticResource SectionTitle}" />
                    <Editor Text="{Binding Config.Plantilla}" AutoSize="TextChanges" />
                </VerticalStackLayout>
            </Border>

            <!-- Plantilla Recordatorio -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="MENSAJE DE RECORDATORIO" Style="{StaticResource SectionTitle}" />
                    <Editor Text="{Binding Config.PlantillaRec}" AutoSize="TextChanges" />
                </VerticalStackLayout>
            </Border>

            <!-- Enlace de Pago -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ENLACE DE PAGO (ALIAS, CBU, LINK)" Style="{StaticResource SectionTitle}" />
                    <Editor Text="{Binding Config.EnlacePago}" AutoSize="TextChanges" Placeholder="Ej: mi.alias.mp" />
                    <Label Text="Podés usar el comodín {enlace_pago} en los mensajes de arriba." Style="{StaticResource Hint}" />
                </VerticalStackLayout>
            </Border>

            <!-- Copia de Seguridad en la Nube -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="COPIA DE SEGURIDAD (DRIVE / NUBE)" Style="{StaticResource SectionTitle}" />
                    <Label Text="Guardá un respaldo de toda tu información en tu Drive o correo, o restaurala si cambiaste de celular." Style="{StaticResource Hint}" />
                    <Label Text="{Binding UltimoBackupTexto}" FontSize="11" TextColor="{StaticResource AccentGreen}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="☁️ Guardar Backup" Style="{StaticResource BtnSuccess}" Command="{Binding ExportarArchivoCommand}" />
                        <Button Grid.Column="1" Text="🔄 Restaurar Backup" Style="{StaticResource BtnDanger}" Command="{Binding ImportarArchivoCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Importar / Exportar JSON Manual -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="EXPORTAR DATOS" Style="{StaticResource SectionTitle}" />
                    <Button Text="⬆ Generar Exportación" Style="{StaticResource BtnGhost}" Command="{Binding ExportarJsonCommand}" />

                    <VerticalStackLayout IsVisible="{Binding HayExportText}" Spacing="10">
                        <Editor Text="{Binding ExportText}" IsReadOnly="True" HeightRequest="80" FontSize="11" />
                        <Button Text="📋 Copiar al portapapeles" Style="{StaticResource BtnPrimary}" Command="{Binding CopiarExportCommand}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DEDCEE, Dark=#3A3370}" Margin="0,10" />

                    <Label Text="IMPORTAR DATOS" Style="{StaticResource SectionTitle}" />
                    <Label Text="Pegá acá el texto exportado para restaurar la información." Style="{StaticResource Hint}" />
                    <Editor Text="{Binding ImportText}" HeightRequest="80" Placeholder="Pegar JSON..." FontSize="11" />
                    <Button Text="⬇ Importar y reemplazar" BackgroundColor="{StaticResource AccentRed}" TextColor="#F5F3FF" CornerRadius="10" Command="{Binding ImportarJsonCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Guardar ajustes" Style="{StaticResource BtnSuccess}" Margin="0,10,0,20" Command="{Binding GuardarAjustesCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
