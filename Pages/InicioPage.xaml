<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCobros.PageModels"
             x:Class="AppCobros.Pages.InicioPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F4F3FB, Dark=#141221}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="#221C44" StrokeThickness="0" Padding="18,18,18,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,10,10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="14">
                <Label Text="LIBRETA DE COBROS" TextColor="{StaticResource AccentAmber}" FontSize="13" FontAttributes="Bold" CharacterSpacing="2.2" />
                <Label Text="{Binding MesActual, StringFormat='{0} · Resumen'}" TextColor="#B7B3D9" FontSize="12" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" BackgroundColor="#10FFFFFF" Stroke="#1EFFFFFF" Padding="12,10" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout>
                            <Label Text="POR COBRAR" TextColor="#A5A0CC" FontSize="10" CharacterSpacing="1.4" />
                            <Label Text="{Binding TotalPendiente, StringFormat='{0:C0}'}" TextColor="#FFB0A5" FontSize="17" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#10FFFFFF" Stroke="#1EFFFFFF" Padding="12,10" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout>
                            <Label Text="COBRADO ESTE MES" TextColor="#A5A0CC" FontSize="10" CharacterSpacing="1.4" />
                            <Label Text="{Binding TotalCobradoMes, StringFormat='{0:C0}'}" TextColor="#8FE6BE" FontSize="17" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="14,16,14,0">
            <VerticalStackLayout Spacing="12">

                <!-- Cuotas del mes -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="CUOTAS DEL MES" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout IsVisible="{Binding HayClientesSinFacturar}" Spacing="10">
                            <Label Text="{Binding ClientesSinFacturarCount, StringFormat='{0} cliente(s) sin la cuota de este mes cargada.'}" Style="{StaticResource Hint}" FontSize="13" />
                            <Button Text="Cargar cuotas del mes a todos" Style="{StaticResource BtnPrimary}" Command="{Binding CargarCuotasDelMesCommand}" />
                        </VerticalStackLayout>

                        <Border BackgroundColor="{AppThemeBinding Light=#DDF5EA, Dark=#153828}" Stroke="{AppThemeBinding Light=#BCE8D4, Dark=#1F5138}" Padding="12,11" StrokeShape="RoundRectangle 10"
                                IsVisible="{Binding TodosFacturados}">
                            <Label Text="✓ Todas las cuotas del mes ya están cargadas." TextColor="{AppThemeBinding Light=#221C44, Dark=#8FE6BE}" FontSize="13" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Cuentas con deuda -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="CUENTAS CON DEUDA" Style="{StaticResource SectionTitle}" />

                        <Button Text="📲 Reclamar a todos por WhatsApp" Style="{StaticResource BtnWhatsApp}" Command="{Binding ReclamarATodosCommand}" />

                        <CollectionView ItemsSource="{Binding ClientesConDeuda}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClientItemViewModel">
                                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,9">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InicioViewModel}}, Path=GoToClientCommand}" CommandParameter="{Binding Client.Id}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                    WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                                                    BackgroundColor="{AppThemeBinding Light=#221C44, Dark=#3A3370}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Exigible}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentRed}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Iniciales}" TextColor="White"
                                                       HorizontalOptions="Fill" VerticalOptions="Fill"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                       FontAttributes="Bold" FontSize="12" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Detalle}" Style="{StaticResource Hint}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                                <Label Text="{Binding SaldoTexto}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource AccentRed}" HorizontalOptions="End" />
                                                <Label Text="{Binding EstadoTexto}" Style="{StaticResource Hint}" FontSize="10" HorizontalOptions="End" TextTransform="Uppercase" CharacterSpacing="1" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
