<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCobros.PageModels"
             x:Class="AppCobros.Pages.ClienteDetallePage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F4F3FB, Dark=#141221}">

    <ScrollView Padding="14">
        <VerticalStackLayout Spacing="12">
            
            <Border BackgroundColor="#FFFFFF" Stroke="#DEDCEE" StrokeShape="RoundRectangle 12" Padding="20,14">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="SALDO DE LA CUENTA" TextColor="#75718F" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.6" HorizontalOptions="Center" />
                    <Label Text="{Binding Saldo, StringFormat='{0:C0}'}" FontSize="36" FontAttributes="Bold" TextColor="#221C44" HorizontalOptions="Center" />
                    <Label Text="{Binding EstadoTexto}" TextColor="#E14D43" FontAttributes="Bold" FontSize="11" CharacterSpacing="2" TextTransform="Uppercase" HorizontalOptions="Center" />
                    <Label Text="{Binding DetalleTexto}" TextColor="#75718F" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Button Text="💵 Registrar cobro" BackgroundColor="#0FA36B" TextColor="White" CornerRadius="10" Command="{Binding RegistrarCobroCommand}" />
            <Button Text="📲 Enviar recordatorio de deuda" BackgroundColor="#1FAF59" TextColor="White" CornerRadius="10" Command="{Binding EnviarRecordatorioCommand}" IsVisible="{Binding IsExigible}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="＋ Cargo manual" BackgroundColor="Transparent" TextColor="#3A3370" BorderColor="#DEDCEE" BorderWidth="1.5" CornerRadius="10" Command="{Binding AgregarCargoCommand}" />
                <Button Grid.Column="1" Text="✎ Editar cliente" BackgroundColor="Transparent" TextColor="#3A3370" BorderColor="#DEDCEE" BorderWidth="1.5" CornerRadius="10" />
            </Grid>

            <Border BackgroundColor="#FFFFFF" Stroke="#DEDCEE" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="HISTORIAL" TextColor="#75718F" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.6" />
                    
                    <StackLayout BindableLayout.ItemsSource="{Binding Movimientos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="52,*,Auto,Auto" ColumnSpacing="10" Padding="0,10" Margin="0,0,0,1" BackgroundColor="White">
                                    <Label Grid.Column="0" Text="{Binding Fecha}" FontSize="11" TextColor="#75718F" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Concepto}" FontSize="13" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Monto, StringFormat='{0:C0}'}" FontSize="14" FontAttributes="Bold" TextColor="#E14D43" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Tipo}" Value="pago">
                                                <Setter Property="TextColor" Value="#0FA36B" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Button Grid.Column="3" Text="✕" BackgroundColor="Transparent" TextColor="#75718F" FontSize="15" Padding="4" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClienteDetalleViewModel}}, Path=BorrarMovimientoCommand}" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
