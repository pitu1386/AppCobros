<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCobros.PageModels"
             xmlns:models="clr-namespace:AppCobros.Models"
             x:Class="AppCobros.Pages.ClienteDetallePage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F4F3FB, Dark=#141221}">

    <ScrollView Padding="14">
        <VerticalStackLayout Spacing="12">

            <Border BackgroundColor="{AppThemeBinding Light=#FFF3DC, Dark=#3D2E10}" Stroke="{AppThemeBinding Light=#FFE0A3, Dark=#5C4419}" StrokeShape="RoundRectangle 10" Padding="12,10"
                    IsVisible="{Binding Client.Archivado}">
                <Label Text="📦 Este cliente está archivado. No aparece en las listas activas ni en los reclamos." TextColor="{AppThemeBinding Light=#8A6116, Dark=#FFD98F}" FontSize="12" />
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,14">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="SALDO DE LA CUENTA" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />
                    <Label Text="{Binding Saldo, StringFormat='{0:C0}'}" FontSize="36" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{Binding EstadoTexto}" TextColor="{StaticResource AccentRed}" FontAttributes="Bold" FontSize="11" CharacterSpacing="2" TextTransform="Uppercase" HorizontalOptions="Center" />
                    <Label Text="{Binding DetalleTexto}" Style="{StaticResource Hint}" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Button Text="💵 Registrar cobro" Style="{StaticResource BtnSuccess}" Command="{Binding RegistrarCobroCommand}" />
            <Button Text="📲 Enviar recordatorio de deuda" Style="{StaticResource BtnWhatsApp}" Command="{Binding EnviarRecordatorioCommand}" IsVisible="{Binding IsExigible}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="＋ Cargo manual" Style="{StaticResource BtnGhost}" Command="{Binding AgregarCargoCommand}" />
                <Button Grid.Column="1" Text="✎ Editar cliente" Style="{StaticResource BtnGhost}" Command="{Binding EditarClienteCommand}" />
            </Grid>

            <Button Text="📄 Compartir estado de cuenta" Style="{StaticResource BtnGhost}" Command="{Binding EnviarEstadoCuentaCommand}" />

            <!-- Pendiente de pago -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding TienePendientes}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="PENDIENTE DE PAGO" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <StackLayout BindableLayout.ItemsSource="{Binding Pendientes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Movimiento">
                                <Grid ColumnDefinitions="*,Auto" Padding="2,7">
                                    <Label Grid.Column="0" Text="{Binding Concepto}" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding Monto, StringFormat='{0:C0}'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentRed}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DEDCEE, Dark=#3A3370}" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="*,Auto" Padding="2,9,2,2">
                        <Label Grid.Column="0" Text="Total a reclamar" FontSize="13" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding TotalExigible, StringFormat='{0:C0}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentRed}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Historial -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="HISTORIAL" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />

                    <StackLayout BindableLayout.ItemsSource="{Binding Movimientos}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Movimiento">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Padding="0,4" Margin="0">
                                    <Label Grid.Column="0" Text="{Binding FechaCorta}" Style="{StaticResource Hint}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Concepto}" FontSize="13" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding MontoConSigno}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentGreen}" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Tipo}" Value="cargo">
                                                <Setter Property="TextColor" Value="{StaticResource AccentRed}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Column="3" Text="✕" FontSize="14" TextColor="{AppThemeBinding Light=#BBBBBB, Dark=#75718F}"
                                           VerticalOptions="Center" HorizontalOptions="Center"
                                           Padding="6,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClienteDetalleViewModel}}, Path=BorrarMovimientoCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="📦 Archivar cliente" Style="{StaticResource BtnGhost}" Command="{Binding ArchivarClienteCommand}" IsVisible="{Binding ClienteActivo}" Margin="0,4,0,8" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding Client.Archivado}" Margin="0,4,0,20">
                <Button Grid.Column="0" Text="↩ Reactivar" Style="{StaticResource BtnSuccess}" Command="{Binding ReactivarClienteCommand}" />
                <Button Grid.Column="1" Text="🗑 Eliminar definitivo" Style="{StaticResource BtnDanger}" Command="{Binding BorrarClienteCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
