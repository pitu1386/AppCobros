<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCobros.PageModels"
             x:Class="AppCobros.Pages.ClientesPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F4F3FB, Dark=#141221}">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Search bar -->
        <Border Grid.Row="0" Margin="14" Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 9">
            <SearchBar Placeholder="Buscar cliente…" Text="{Binding SearchText}"
                       TextColor="{AppThemeBinding Light=#221C44, Dark=#F5F3FF}"
                       PlaceholderColor="{AppThemeBinding Light=#75718F, Dark=#8D88B5}" />
        </Border>

        <!-- Orden + Filtro + Nuevo cliente -->
        <Grid Grid.Row="1" Margin="14,0,14,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ScrollView Grid.Column="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 9" Padding="12,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSortCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Orden:" Style="{StaticResource Hint}" FontSize="12" VerticalOptions="Center" />
                            <Label Text="{Binding OrdenLabel}" FontSize="12" TextColor="{AppThemeBinding Light=#3A3370, Dark=#B7B3D9}" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 9" Padding="12,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFiltroEstadoCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Estado:" Style="{StaticResource Hint}" FontSize="12" VerticalOptions="Center" />
                            <Label Text="{Binding FiltroEstadoLabel}" FontSize="12" TextColor="{AppThemeBinding Light=#3A3370, Dark=#B7B3D9}" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 9" Padding="12,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ElegirGrupoCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Grupo:" Style="{StaticResource Hint}" FontSize="12" VerticalOptions="Center" />
                            <Label Text="{Binding FiltroGrupoLabel}" FontSize="12" TextColor="{AppThemeBinding Light=#3A3370, Dark=#B7B3D9}" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
            <Button Grid.Column="1" Text="＋ Nuevo" Style="{StaticResource BtnSuccess}" FontSize="12" Padding="12,0" HeightRequest="36" CornerRadius="9"
                    Command="{Binding NuevoClienteCommand}" />
        </Grid>

        <!-- Lista -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding GruposDeClientes}" IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ClientGroupViewModel">
                    <Grid ColumnDefinitions="*,Auto" Padding="14,10,14,5">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light=#3A3370, Dark=#B7B3D9}" TextTransform="Uppercase" CharacterSpacing="0.6" />
                            <Label Text="{Binding Descripcion}" Style="{StaticResource Hint}" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="{AppThemeBinding Light=#DEDCEE, Dark=#3A3370}" StrokeShape="RoundRectangle 8"
                                Padding="10,6" VerticalOptions="Center"
                                IsVisible="{Binding IsRealGroup}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClientesViewModel}}, Path=NuevoClienteEnGrupoCommand}"
                                    CommandParameter="{Binding GrupoId}" />
                            </Border.GestureRecognizers>
                            <Label Text="＋ Agregar" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AccentGreen}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientItemViewModel">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="14,4,14,5">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClientesViewModel}}, Path=GoToClientCommand}" CommandParameter="{Binding Client.Id}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                                    BackgroundColor="{AppThemeBinding Light=#221C44, Dark=#3A3370}">
                                <Label Text="{Binding Iniciales}" TextColor="White"
                                       HorizontalOptions="Fill" VerticalOptions="Fill"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       FontAttributes="Bold" FontSize="12" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Detalle}" Style="{StaticResource Hint}" FontSize="12" />
                                <Label Text="📦 Archivado" FontSize="10" TextColor="{StaticResource AccentAmber}" IsVisible="{Binding EsArchivado}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding SaldoTexto}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource AccentRed}" HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding TieneDeuda}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource AccentGreen}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding EstadoTexto}" Style="{StaticResource Hint}" FontSize="10" HorizontalOptions="End" TextTransform="Uppercase" CharacterSpacing="1" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
