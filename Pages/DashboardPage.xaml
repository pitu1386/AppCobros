<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppCobros.PageModels"
             x:Class="AppCobros.Pages.DashboardPage"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F4F3FB, Dark=#141221}">

    <ScrollView Padding="14">
        <VerticalStackLayout Spacing="12">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto, Auto" RowSpacing="10">
                <!-- Cobranza Mes Actual -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="COBRADO ESTE MES" Style="{StaticResource SectionTitle}" FontSize="10" CharacterSpacing="1" />
                        <Label Text="{Binding CobranzaMesActual, StringFormat='{0:C0}'}" TextColor="{StaticResource AccentGreen}" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Deuda Total -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="DEUDA EN CALLE" Style="{StaticResource SectionTitle}" FontSize="10" CharacterSpacing="1" />
                        <Label Text="{Binding DeudaTotal, StringFormat='{0:C0}'}" TextColor="{StaticResource AccentRed}" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Proyección de Ingresos -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PROYECCIÓN MENSUAL" Style="{StaticResource SectionTitle}" FontSize="10" CharacterSpacing="1" />
                        <Label Text="{Binding ProyeccionIngresos, StringFormat='{0:C0}'}" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Clientes Activos -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="CLIENTES ACTIVOS" Style="{StaticResource SectionTitle}" FontSize="10" CharacterSpacing="1" />
                        <Label Text="{Binding ClientesActivos}" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Recaudado en Euros -->
            <Border BackgroundColor="#221C44" Stroke="#3A3370" StrokeShape="RoundRectangle 12" Padding="14"
                    IsVisible="{Binding HayCotizacion}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="COBRADO ESTE MES EN EUROS" TextColor="#A5A0CC" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                        <Label Text="{Binding CobradoEurosTexto}" TextColor="{StaticResource AccentAmber}" FontSize="22" FontAttributes="Bold" />
                        <Label Text="{Binding CotizacionDetalle}" TextColor="#B7B3D9" FontSize="11" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="💶" FontSize="30" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Historial de Cobros (Últimos 6 meses) -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="HISTORIAL DE COBROS (6 MESES)" Style="{StaticResource SectionTitle}" />

                    <StackLayout BindableLayout.ItemsSource="{Binding HistorialCobros}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistorialMesViewModel">
                                <Grid ColumnDefinitions="90, *, 80" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding MesLabel}" Style="{StaticResource Hint}" FontSize="12" VerticalOptions="Center" />
                                    <!-- ProgressBar simulation -->
                                    <Grid Grid.Column="1" HeightRequest="16" BackgroundColor="{AppThemeBinding Light=#F4F3FB, Dark=#1A172C}" VerticalOptions="Center">
                                        <BoxView HorizontalOptions="Start" WidthRequest="{Binding HeightPercentage}" BackgroundColor="#8FE6BE" CornerRadius="4"/>
                                    </Grid>
                                    <Label Grid.Column="2" Text="{Binding MontoTexto}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Top Deudores -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="MAYORES DEUDORES" Style="{StaticResource SectionTitle}" />

                    <StackLayout BindableLayout.ItemsSource="{Binding TopDeudores}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClientItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,8" Padding="0,0,0,8">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="15" />
                                        <Label Text="{Binding SaldoTexto, StringFormat='Debe {0}'}" FontSize="12" TextColor="{StaticResource AccentRed}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Reclamar" Style="{StaticResource BtnWhatsApp}" HeightRequest="35" Padding="10,0" CornerRadius="8"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=EnviarRecordatorioCommand}" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
