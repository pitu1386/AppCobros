@inject ICobrosDataService Data
@inject ThemeService Theme
@implements IDisposable

<header class="shrink-0 flex items-center justify-between px-4 py-3 border-b border-line bg-surface z-20
               pt-[max(0.75rem,env(safe-area-inset-top))]">
    <button class="flex items-center gap-2 min-w-0" @onclick='() => Go("dashboard")'>
        <span class="text-xl shrink-0">🧾</span>
        <span class="font-cond font-extrabold text-lg tracking-wide truncate">LIBRETA DE COBROS</span>
    </button>
    <div class="flex items-center gap-3 shrink-0">
        <span class="text-[11px] @(Data.IsRealtimeConnected ? "text-oktext" : "text-faint")" title="@SyncTitle">
            @(Data.IsRealtimeConnected ? "● en vivo" : "○ offline")
        </span>
        <button @onclick="Theme.ToggleAsync" class="text-base" title="Tema">@(Theme.IsDark ? "☀️" : "🌙")</button>
    </div>
</header>

<main class="flex-1 min-h-0 overflow-y-auto overscroll-contain">
    @switch (_view)
    {
        case "dashboard": <DashboardView OnOpenCliente="OpenCliente" /> break;
        case "inicio":    <InicioView OnOpenCliente="OpenCliente" OnReclamarMasivo='() => Go("reclamar")' /> break;
        case "clientes":  <ClientesView OnOpenCliente="OpenCliente" OnNuevoCliente="() => OpenForm(null)" OnNuevoEnGrupo="OpenFormEnGrupo" /> break;
        case "ajustes":   <AjustesView OnOpenPapelera='() => Go("papelera")' OnOpenDashboard='() => Go("dashboard")' OnLogout="Data.LogoutAsync" /> break;
        case "papelera":  <PapeleraView OnBack='() => Go("ajustes")' /> break;
        case "reclamar":  <ReclamarMasivoView OnBack='() => Go("inicio")' /> break;
        case "cliente":   <ClienteDetalleView ClienteId="@_clienteId" OnBack="BackFromCliente" OnEdit="() => OpenForm(_clienteId)" /> break;
        case "form":      <ClienteFormView ClienteId="@_formClienteId" PreGrupoId="@_formGrupoId" OnDone="DoneForm" OnCancel="CancelForm" /> break;
    }
</main>

@if (_view != "form")
{
    <nav class="shrink-0 flex border-t border-line bg-surface pb-[env(safe-area-inset-bottom)]">
        @foreach (var (key, icon, label) in Tabs)
        {
            <button @onclick='() => Go(key)'
                    class="flex-1 flex flex-col items-center gap-0.5 py-2 text-[11px] font-semibold transition-colors
                           @(_view == key ? "text-brandtext" : "text-faint hover:text-ink")">
                <span class="text-lg leading-none">@icon</span>@label
            </button>
        }
    </nav>
}

@code {
    [Parameter] public EventCallback OnLogout { get; set; }

    private static readonly (string Key, string Icon, string Label)[] Tabs =
    {
        ("dashboard", "📊", "Panel"),
        ("inicio", "🏠", "Gestión"),
        ("clientes", "👥", "Clientes"),
        ("ajustes", "⚙️", "Ajustes"),
    };

    private string _view = "dashboard";
    private string _clienteId = "";
    private string? _formClienteId;
    private string? _formGrupoId;
    private string _returnTo = "clientes";

    private string SyncTitle => Data.LastSyncUtc is { } t
        ? $"Última sincronización: {t.ToLocalTime():dd/MM HH:mm:ss}" : "Sin sincronizar todavía";

    protected override async Task OnInitializedAsync()
    {
        Theme.OnChange += OnStateChanged;
        await Theme.InitializeAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void Go(string view)
    {
        _view = view;
        if (view is "dashboard" or "inicio" or "clientes" or "ajustes")
        {
            _clienteId = "";
            _formClienteId = null;
            _formGrupoId = null;
        }
    }

    private void OpenCliente(string id)
    {
        _returnTo = _view is "cliente" or "form" ? _returnTo : _view;
        _clienteId = id;
        _view = "cliente";
    }

    private void BackFromCliente() => _view = _returnTo;

    private void OpenForm(string? clienteId)
    {
        _formClienteId = clienteId;
        _formGrupoId = null;
        _view = "form";
    }

    private void OpenFormEnGrupo(string grupoId)
    {
        _formClienteId = null;
        _formGrupoId = grupoId;
        _view = "form";
    }

    private void DoneForm(string clienteId)
    {
        _clienteId = clienteId;
        _view = "cliente";
    }

    private void CancelForm() => _view = string.IsNullOrEmpty(_formClienteId) ? _returnTo : "cliente";

    public void Dispose() => Theme.OnChange -= OnStateChanged;
}
